# Copy this file to .env and fill in real values. .env is gitignored and must
# never be committed. Do not put real secrets in this example file.

# --- Milestone 1: query API (local dev) ---
QUERY_API_JWT_SECRET=replace-with-local-dev-secret
QUERY_API_ISSUER=http://localhost:8080/dev-issuer

# --- Milestone 2: Hyper-V unattended autoinstall (optional) ---
# Consumed at provisioning time by Invoke-LabProvisioning -Autoinstall to render
# the NoCloud autoinstall user-data into the seed staging area (outside the repo).
#
# Login account created on each guest.
LAB_AUTOINSTALL_USERNAME=labadmin
LAB_AUTOINSTALL_FULL_NAME=Lab Administrator
# Hashed password (NOT plaintext). Generate with:
#   openssl passwd -6 'your-password'      (or)   mkpasswd --method=SHA-512
LAB_AUTOINSTALL_PASSWORD_HASH=$6$replace$with-a-real-sha512-crypt-hash
# One or more SSH public keys (separate multiple keys with a newline or ';').
LAB_AUTOINSTALL_SSH_AUTHORIZED_KEYS=ssh-ed25519 AAAA...replace-with-your-public-key you@example

