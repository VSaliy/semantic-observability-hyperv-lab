{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/operational-event.schema.json",
  "title": "OperationalEvent",
  "type": "object",
  "required": [
    "schemaVersion",
    "eventId",
    "eventType",
    "sourceId",
    "timestamp",
    "tenantId",
    "environment",
    "service",
    "severity",
    "summary",
    "evidence"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "eventId": {"type": "string", "minLength": 1},
    "eventType": {
      "type": "string",
      "enum": [
        "application.error",
        "application.latency",
        "trace.failure",
        "deployment.started",
        "deployment.completed",
        "alert.firing",
        "alert.resolved",
        "network.route.changed",
        "network.interface.down",
        "kafka.consumer.lag",
        "incident.created",
        "incident.resolved",
        "runbook.updated"
      ]
    },
    "sourceId": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "tenantId": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "minLength": 1},
    "service": {
      "type": "object",
      "required": ["name", "namespace", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "namespace": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "changeId": {"type": "string"},
    "severity": {"type": "string", "enum": ["INFO", "WARN", "ERROR", "CRITICAL"]},
    "summary": {"type": "string", "minLength": 1},
    "attributes": {"type": "object", "additionalProperties": true},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "system", "url"],
        "properties": {
          "type": {"type": "string", "minLength": 1},
          "system": {"type": "string", "minLength": 1},
          "url": {"type": "string", "format": "uri"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
